# Copy to .env and change every value. Never commit .env.
POSTGRES_DB=portfolioiq
POSTGRES_USER=portfolioiq
POSTGRES_PASSWORD=change-me
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars-or-more
JWT_EXPIRATION_MINUTES=60
# Optional. If empty, the app serves clearly labelled SIMULATED market data.
MARKET_DATA_API_KEY=
