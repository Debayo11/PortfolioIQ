# Copy to .env and change every value. Never commit .env.
POSTGRES_DB=portfolioiq
POSTGRES_USER=portfolioiq
POSTGRES_PASSWORD=change-me
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars-or-more
JWT_EXPIRATION_MINUTES=60
# Optional Finnhub API key. If empty, the app serves clearly labelled SIMULATED market data.
MARKET_DATA_API_KEY=

# Email. Without SMTP, set APP_MAIL_LOG_ONLY=true in development to see verification/reset links in the backend log.
# In production set it to false and configure SMTP by adding SPRING_MAIL_HOST, SPRING_MAIL_PORT,
# SPRING_MAIL_USERNAME and SPRING_MAIL_PASSWORD to the backend service environment.
APP_MAIL_LOG_ONLY=true
MAIL_FROM=no-reply@portfolioiq.local
# Where email links point. Docker Compose serves the app on 3000; the Vite dev server uses 5173.
FRONTEND_URL=http://localhost:3000
# Set true in production: unverified accounts cannot sign in.
REQUIRE_VERIFIED_EMAIL=false

# Market refresh and rate limiting (defaults shown)
MARKET_REFRESH_INTERVAL_MS=300000
MARKET_MAX_REQUESTS_PER_REFRESH=50
MARKET_CACHE_TTL_SECONDS=60
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120
